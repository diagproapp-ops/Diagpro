# Banco de Dados (use diagpro_runtime para a API e diagpro_admin apenas no Alembic)
DATABASE_URL=postgresql+asyncpg://diagpro_runtime:CHANGE_ME@127.0.0.1:5435/diagpro
# TLS obrigatório com o banco: verify-full valida a CA e o nome do servidor
DB_SSLMODE=verify-full
DB_SSL_ROOT_CERT=C:/caminho/fora/do/projeto/pg-tls/ca.crt
# Role BYPASSRLS usada só em login, cadastro público e administrador geral (senha diferente da runtime)
PLATFORM_DATABASE_URL=postgresql+asyncpg://diagpro_platform:CHANGE_ME@127.0.0.1:5435/diagpro
ALEMBIC_DATABASE_URL=postgresql+psycopg2://diagpro_admin:CHANGE_ME@127.0.0.1:5435/diagpro

# Docker Compose PostgreSQL
POSTGRES_DB=diagpro
POSTGRES_USER=diagpro_admin
POSTGRES_PASSWORD=CHANGE_ME
POSTGRES_PORT=5435

# Segurança e Criptografia (gerar valores fortes fora do repositório)
JWT_SECRET_KEY=CHANGE_ME_STRONG_RANDOM_SECRET
# Chave mestra da cifragem de campos: arquivo FORA do projeto (gere com: python -m backend.app.field_crypto genkey)
DIAGPRO_MASTER_KEY_FILE=C:/caminho/fora/do/projeto/secrets/master.key
CORS_ORIGINS=http://localhost:3000,http://127.0.0.1:3000
ENABLE_HSTS=false
RATE_LIMIT_ENABLED=true

# Integrações Externas
RECAPTCHA_SECRET_KEY=
OPENAI_API_KEY=
BING_API_KEY=

# Escala: Redis e Object Storage (S3 / MinIO)
REDIS_URL=
S3_ENDPOINT_URL=
S3_BUCKET=
S3_ACCESS_KEY=
S3_SECRET_KEY=
LOCAL_STORAGE_DIR=storage_data
